---
const { href, texto, bottonI18n, variant = 'primary' } = Astro.props;
---

<a class:list={['button', `button--${variant}`]} href={href} data-i18n={bottonI18n}>{texto}</a>

<style>
	.button {
		display: flex;
		justify-content: center;
		align-items: center;
		padding: 1.1rem 2.6rem;
		border-radius: 100px;
		font-size: var(--text-large);
		font-weight: 600;
		max-width: max-content;
		transition:
			transform var(--dur-fast) var(--ease-spring),
			box-shadow var(--dur-base) var(--ease-spring),
			background-position var(--dur-base) var(--ease-spring),
			background-color var(--dur-fast) var(--ease-spring),
			border-color var(--dur-fast) var(--ease-spring);
	}

	.button--primary {
		background-image: linear-gradient(120deg, var(--primary-50), var(--secondary-50), var(--primary-50));
		background-size: 200% 100%;
		background-position: 0% 50%;
		color: #fff;
		box-shadow: 0 4px 14px color-mix(in srgb, var(--primary-60) 30%, transparent);
	}

	.button--primary:hover {
		transform: translateY(-2px);
		background-position: 100% 50%;
		box-shadow: 0 8px 24px color-mix(in srgb, var(--primary-60) 45%, transparent);
	}

	.button--primary:active {
		transform: translateY(0) scale(0.98);
		box-shadow: 0 3px 10px color-mix(in srgb, var(--primary-60) 30%, transparent);
	}

	.button--ghost {
		background: transparent;
		border: 1px solid var(--primary-50);
		color: var(--primary-90);
	}

	.button--ghost:hover {
		transform: translateY(-2px);
		background-color: color-mix(in srgb, var(--primary-50) 15%, transparent);
		border-color: var(--primary-60);
		box-shadow: 0 8px 24px color-mix(in srgb, var(--primary-60) 20%, transparent);
	}

	.button--ghost:active {
		transform: translateY(0) scale(0.98);
	}

	@media (prefers-reduced-motion: reduce) {
		.button,
		.button:hover,
		.button:active {
			transition: none;
			transform: none;
		}
	}
</style>
