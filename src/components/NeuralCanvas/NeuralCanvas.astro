<canvas id="neural-canvas" aria-hidden="true"></canvas>

<style>
	#neural-canvas {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		pointer-events: none;
		z-index: 0;
	}
</style>

<script>
(function () {
	const canvas = document.getElementById('neural-canvas');
	if (!canvas || !(canvas instanceof HTMLCanvasElement)) return;

	if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		canvas.style.display = 'none';
		return;
	}

	const ctx = canvas.getContext('2d');

	const CFG = {
		nodeDensity: 18000, // px² por nodo: la cantidad se adapta a la pantalla
		minNodes: 30,
		maxNodes: 90,
		maxDist: 155,
		minSpeed: 0.12,
		maxSpeed: 0.55,
		minRadius: 1.5,
		maxRadius: 3.2,
		repulsionRadius: 115,
		repulsionStrength: 0.3,
		speedCap: 1.6,
		damping: 0.984,
		pulseChance: 0.028,
		pulseStep: 0.0065,
		// Propagación en cadena: al llegar una señal puede saltar al siguiente nodo
		chainChance: 0.55,
		maxChainGen: 3,
		maxPulses: 36,
		cursorRadius: 170,
	};

	let W = 0, H = 0;
	let nodes = [];
	let pulses = [];
	let rings = [];
	let mouse = { x: -9999, y: -9999 };
	let primary = { r: 134, g: 100, b: 238 };   // --primary-60 fallback
	let secondary = { r: 220, g: 88, b: 152 };  // --secondary-60 fallback

	function hexToRgb(hex) {
		const h = hex.trim().replace('#', '');
		if (h.length !== 6) return null;
		return {
			r: parseInt(h.slice(0, 2), 16),
			g: parseInt(h.slice(2, 4), 16),
			b: parseInt(h.slice(4, 6), 16),
		};
	}

	function readColors() {
		const s = getComputedStyle(document.documentElement);
		const p = hexToRgb(s.getPropertyValue('--primary-60').trim());
		const sec = hexToRgb(s.getPropertyValue('--secondary-60').trim());
		if (p) primary = p;
		if (sec) secondary = sec;
	}

	function resize() {
		// Canvas a resolución física (retina): sin esto las líneas se ven borrosas
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		W = window.innerWidth;
		H = window.innerHeight;
		canvas.width = W * dpr;
		canvas.height = H * dpr;
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
	}

	const lerp = (a, b, t) => Math.round(a + (b - a) * t);

	function makeNode() {
		const angle = Math.random() * Math.PI * 2;
		// depth: los nodos "lejanos" son más pequeños, lentos y tenues (parallax sutil)
		const depth = 0.45 + Math.random() * 0.55;
		const speed = (CFG.minSpeed + Math.random() * (CFG.maxSpeed - CFG.minSpeed)) * depth;
		return {
			x: Math.random() * W,
			y: Math.random() * H,
			vx: Math.cos(angle) * speed,
			vy: Math.sin(angle) * speed,
			r: (CFG.minRadius + Math.random() * (CFG.maxRadius - CFG.minRadius)) * depth,
			alpha: (0.55 + Math.random() * 0.45) * (0.6 + depth * 0.4),
			phase: Math.random() * Math.PI * 2,
			// mix: posición de cada nodo en el degradado morado→rosa de la marca
			mix: Math.pow(Math.random(), 1.6) * 0.85,
			flash: 0,
		};
	}

	function targetCount() {
		return Math.max(CFG.minNodes, Math.min(CFG.maxNodes, Math.round((W * H) / CFG.nodeDensity)));
	}

	function spawnPulse(from, gen = 0) {
		if (pulses.length >= CFG.maxPulses) return;
		const a = from || nodes[Math.floor(Math.random() * nodes.length)];
		const maxSq = CFG.maxDist * CFG.maxDist;
		const neighbors = [];
		for (const b of nodes) {
			if (b === a) continue;
			const dx = b.x - a.x, dy = b.y - a.y;
			if (dx * dx + dy * dy < maxSq) neighbors.push(b);
		}
		if (!neighbors.length) return;
		const to = neighbors[Math.floor(Math.random() * neighbors.length)];
		pulses.push({ from: a, to, t: 0, gen });
	}

	function update() {
		for (const n of nodes) {
			const dx = n.x - mouse.x;
			const dy = n.y - mouse.y;
			const dSq = dx * dx + dy * dy;
			const rSq = CFG.repulsionRadius * CFG.repulsionRadius;

			if (dSq < rSq && dSq > 0.01) {
				const d = Math.sqrt(dSq);
				const f = (1 - d / CFG.repulsionRadius) * CFG.repulsionStrength;
				n.vx += (dx / d) * f;
				n.vy += (dy / d) * f;
			}

			const spd = Math.sqrt(n.vx * n.vx + n.vy * n.vy);
			if (spd > CFG.speedCap) {
				n.vx = (n.vx / spd) * CFG.speedCap;
				n.vy = (n.vy / spd) * CFG.speedCap;
			}

			n.vx *= CFG.damping;
			n.vy *= CFG.damping;
			n.x += n.vx;
			n.y += n.vy;
			n.phase += 0.022;
			if (n.flash > 0) n.flash *= 0.93;

			if (n.x < 0)  { n.x = 0;  n.vx = Math.abs(n.vx); }
			if (n.x > W)  { n.x = W;  n.vx = -Math.abs(n.vx); }
			if (n.y < 0)  { n.y = 0;  n.vy = Math.abs(n.vy); }
			if (n.y > H)  { n.y = H;  n.vy = -Math.abs(n.vy); }
		}

		for (let i = pulses.length - 1; i >= 0; i--) {
			const p = pulses[i];
			p.t += CFG.pulseStep;
			if (p.t >= 1) {
				// La señal "activa" al nodo receptor y puede seguir propagándose
				p.to.flash = 1;
				if (p.gen < CFG.maxChainGen && Math.random() < CFG.chainChance) {
					spawnPulse(p.to, p.gen + 1);
				}
				pulses.splice(i, 1);
			}
		}

		for (let i = rings.length - 1; i >= 0; i--) {
			rings[i].t += 0.018;
			if (rings[i].t >= 1) rings.splice(i, 1);
		}

		if (Math.random() < CFG.pulseChance) spawnPulse();
	}

	function draw() {
		ctx.clearRect(0, 0, W, H);

		const MAX = CFG.maxDist;
		const pr = primary.r, pg = primary.g, pb = primary.b;
		const sr = secondary.r, sg = secondary.g, sb = secondary.b;

		// Connections — el color interpola entre los tonos de sus dos nodos
		for (let i = 0; i < nodes.length; i++) {
			for (let j = i + 1; j < nodes.length; j++) {
				const a = nodes[i], b = nodes[j];
				const dx = b.x - a.x, dy = b.y - a.y;
				const dSq = dx * dx + dy * dy;
				if (dSq >= MAX * MAX) continue;

				const d = Math.sqrt(dSq);
				const closeness = 1 - d / MAX;
				const alpha = closeness * 0.34;
				const t = (a.mix + b.mix) / 2;
				ctx.beginPath();
				ctx.strokeStyle = `rgba(${lerp(pr, sr, t)},${lerp(pg, sg, t)},${lerp(pb, sb, t)},${alpha})`;
				ctx.lineWidth = 0.5 + closeness * 0.7;
				ctx.moveTo(a.x, a.y);
				ctx.lineTo(b.x, b.y);
				ctx.stroke();
			}
		}

		// El cursor actúa como una neurona más: se enlaza a los nodos cercanos
		if (mouse.x > -9000) {
			const CR = CFG.cursorRadius;
			for (const n of nodes) {
				const dx = n.x - mouse.x, dy = n.y - mouse.y;
				const dSq = dx * dx + dy * dy;
				if (dSq >= CR * CR) continue;
				const d = Math.sqrt(dSq);
				const a = (1 - d / CR) * 0.4;
				ctx.beginPath();
				ctx.strokeStyle = `rgba(${sr},${sg},${sb},${a})`;
				ctx.lineWidth = 0.8;
				ctx.moveTo(mouse.x, mouse.y);
				ctx.lineTo(n.x, n.y);
				ctx.stroke();
			}

			const cg = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, 26);
			cg.addColorStop(0, `rgba(${sr},${sg},${sb},0.32)`);
			cg.addColorStop(1, `rgba(${sr},${sg},${sb},0)`);
			ctx.beginPath();
			ctx.arc(mouse.x, mouse.y, 26, 0, Math.PI * 2);
			ctx.fillStyle = cg;
			ctx.fill();
		}

		// Ondas expansivas de los clics
		for (const ring of rings) {
			const ease = 1 - Math.pow(1 - ring.t, 3);
			const r = ease * 240;
			const a = (1 - ring.t) * 0.45;
			ctx.beginPath();
			ctx.strokeStyle = `rgba(${sr},${sg},${sb},${a})`;
			ctx.lineWidth = 1.5;
			ctx.arc(ring.x, ring.y, r, 0, Math.PI * 2);
			ctx.stroke();
		}

		// Pulses traveling along connections
		for (const p of pulses) {
			const x = p.from.x + (p.to.x - p.from.x) * p.t;
			const y = p.from.y + (p.to.y - p.from.y) * p.t;

			// Fade in/out at endpoints
			const fade = Math.sin(p.t * Math.PI);

			const glow = ctx.createRadialGradient(x, y, 0, x, y, 12);
			glow.addColorStop(0, `rgba(${sr},${sg},${sb},${0.9 * fade})`);
			glow.addColorStop(0.35, `rgba(${sr},${sg},${sb},${0.35 * fade})`);
			glow.addColorStop(1, `rgba(${sr},${sg},${sb},0)`);
			ctx.beginPath();
			ctx.arc(x, y, 12, 0, Math.PI * 2);
			ctx.fillStyle = glow;
			ctx.fill();

			ctx.beginPath();
			ctx.arc(x, y, 2.5, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${sr},${sg},${sb},${fade})`;
			ctx.fill();
		}

		// Nodes — cada uno con su tono propio; al recibir una señal destellan
		for (const n of nodes) {
			const f = n.flash > 0.02 ? n.flash : 0;
			const pulse = 0.72 + Math.sin(n.phase) * 0.28 + f * 0.9;
			const glowR = n.r * (5.5 + f * 4);
			// El destello empuja el color hacia blanco
			const nr = lerp(lerp(pr, sr, n.mix), 255, f * 0.65);
			const ng = lerp(lerp(pg, sg, n.mix), 255, f * 0.65);
			const nb = lerp(lerp(pb, sb, n.mix), 255, f * 0.65);
			const alpha = Math.min(1, n.alpha + f * 0.5);

			const glow = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, glowR);
			glow.addColorStop(0, `rgba(${nr},${ng},${nb},${alpha * 0.55 * pulse})`);
			glow.addColorStop(0.45, `rgba(${nr},${ng},${nb},${alpha * 0.18 * pulse})`);
			glow.addColorStop(1, `rgba(${nr},${ng},${nb},0)`);
			ctx.beginPath();
			ctx.arc(n.x, n.y, glowR, 0, Math.PI * 2);
			ctx.fillStyle = glow;
			ctx.fill();

			ctx.beginPath();
			ctx.arc(n.x, n.y, n.r * pulse, 0, Math.PI * 2);
			ctx.fillStyle = `rgba(${nr},${ng},${nb},${alpha})`;
			ctx.fill();
		}
	}

	let visible = true;
	document.addEventListener('visibilitychange', () => {
		visible = document.visibilityState === 'visible';
		if (visible) tick();
	});

	function tick() {
		if (!visible) return;
		update();
		draw();
		requestAnimationFrame(tick);
	}

	window.addEventListener('resize', () => {
		resize();
		for (const n of nodes) {
			n.x = Math.min(n.x, W);
			n.y = Math.min(n.y, H);
		}
		// Ajustar la densidad al nuevo tamaño
		const target = targetCount();
		while (nodes.length < target) nodes.push(makeNode());
		if (nodes.length > target) nodes.length = target;
	});

	document.addEventListener('mousemove', (e) => {
		mouse.x = e.clientX;
		mouse.y = e.clientY;
	});

	document.addEventListener('mouseleave', () => {
		mouse.x = -9999;
		mouse.y = -9999;
	});

	document.addEventListener('touchmove', (e) => {
		const t = e.touches[0];
		if (t) { mouse.x = t.clientX; mouse.y = t.clientY; }
	}, { passive: true });

	document.addEventListener('touchend', () => {
		mouse.x = -9999;
		mouse.y = -9999;
	});

	// Clic = activación: onda expansiva, empuje suave y señales desde el nodo más cercano
	document.addEventListener('click', (e) => {
		const cx = e.clientX, cy = e.clientY;
		rings.push({ x: cx, y: cy, t: 0 });

		let nearest = null, best = Infinity;
		for (const n of nodes) {
			const dx = n.x - cx, dy = n.y - cy;
			const dSq = dx * dx + dy * dy;
			if (dSq < 220 * 220 && dSq > 0.01) {
				const d = Math.sqrt(dSq);
				const force = (1 - d / 220) * 1.4;
				n.vx += (dx / d) * force;
				n.vy += (dy / d) * force;
			}
			if (dSq < best) { best = dSq; nearest = n; }
		}
		if (nearest) {
			nearest.flash = 1;
			spawnPulse(nearest, 1);
			spawnPulse(nearest, 1);
			spawnPulse(nearest, 1);
		}
	});

	// Re-read palette on theme toggle
	new MutationObserver(readColors).observe(
		document.documentElement,
		{ attributes: true, attributeFilter: ['data-theme'] }
	);

	resize();
	readColors();
	nodes = Array.from({ length: targetCount() }, makeNode);
	tick();
})();
</script>
