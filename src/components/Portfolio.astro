---
import { getImage } from 'astro:assets';
import Title from './atoms/Title.astro';
import { getPortafolioData} from "../components/data/portfolioData.js"
import Card from './card-portfolio/CardPortfolio.astro';
import ProjectCarousel from './ProjectCarousel/ProjectCarousel';

// Separar proyectos destacados (primeros 3 del CV) del resto.
// El carrusel es React, así que las imágenes se resuelven aquí a strings (src/srcset).
const featuredProjects = await Promise.all(
	getPortafolioData.slice(0, 3).map(async (project) => {
		const img = await getImage({
			src: project.imgSrc,
			widths: [480, 760, 1100],
			format: 'webp',
		});
		return { ...project, imgSrc: img.src, imgSrcSet: img.srcSet.attribute };
	})
);
const otherProjects = getPortafolioData.slice(3);
---

<section
	id="portafolio"
	class="flex flex-col w-full  justify-center items-center h-auto min-h-[100dvh] py-[--section-py]"
>
	<div class="portfolio__container">
		<Title contenido="Proyectos" i18nKey="portfolio.title" />
		
		<!-- Carrusel de proyectos destacados -->
		<ProjectCarousel projects={featuredProjects} client:load />
		
		<!-- Grid de otros proyectos -->
		{otherProjects.length > 0 && (
			<div class="other-projects-section">
				<h3 class="other-projects-title" data-i18n="portfolio.otherProjects">Otros Proyectos</h3>
				<div class="portfolio__elements">
					{otherProjects.map((props, i) => (
						<div class="portfolio__reveal" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
							<Card {...props} />
						</div>
					))}
				</div>
			</div>
		)}
	</div>
</section>

<style>
	.portfolio__container {
		width: 100%;
		max-width: var(--max-width);
		padding: 0 2rem;
	}

	.other-projects-section {
		margin-top: 6rem;
	}

	.other-projects-title {
		font-size: 2.2rem;
		font-weight: 600;
		text-align: center;
		color: var(--primary-90);
		margin-bottom: 3rem;
		position: relative;
	}

	.other-projects-title::after {
		content: '';
		position: absolute;
		bottom: -1rem;
		left: 50%;
		transform: translateX(-50%);
		width: 80px;
		height: 3px;
		background: var(--text-gradient);
		border-radius: 2px;
	}

	.portfolio__elements {
		max-width: var(--max-width);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		justify-items: center;
		gap: 3rem;
		width: 100%;
	}

	.portfolio__reveal {
		width: 100%;
		display: flex;
		justify-content: center;
	}

	@media screen and (max-width: 700px) {
		.portfolio__elements {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding: 0 1rem;
		}
	}
</style>

<script>
	import { getIMGAverageColor } from '../utils/average-img-color/average-img-color';

	const $cards = document.querySelectorAll('.card__portfolio');
	$cards.forEach((card) => {
		const $container = card.querySelector<HTMLDivElement>('.descripcion__container');
		const $img = card.querySelector('img');
		if (!$img || !$container) return;

		const setBg = () => {
			const theme = document.documentElement.getAttribute('data-theme') || 'dark';
			if (theme === 'light') {
				$container.style.background = '';
				return;
			}
			const [rbgString] = getIMGAverageColor($img, 0.5);
			if (rbgString) {
				$container.style.background = `linear-gradient(to bottom, ${rbgString}, var(--card-gradient-end))`;
			}
		};

		if ($img.complete && $img.naturalWidth > 0) {
			setBg();
		} else {
			$img.onload = setBg;
		}

		new MutationObserver(setBg).observe(
			document.documentElement,
			{ attributes: true, attributeFilter: ['data-theme'] }
		);
	});
</script>
