---
import { Image } from 'astro:assets';
import './hero.css';
import Boton from '../atoms/Boton.astro';
import foto from '../../assets/img/foto.jpeg';
---

<section class="hero">
	<div class="hero__container">
		<div class="text__content">
			<h1 class="hero__title color__gradiente">Franklin Amador</h1>
			<p class="hero__text" data-i18n="hero.subtitle1">
				Full Stack Developer especializado en Data Engineering, Machine Learning y DevOps.
			</p>
			<p class="hero__subtitle" data-i18n="hero.subtitle2">
				Construyo pipelines de datos robustos, modelos ML en producción y arquitecturas cloud escalables.
			</p>
			<div class="hero__buttons">
				<Boton href="#portafolio" texto="Ver Proyectos" bottonI18n="hero.buttonProjects" variant="primary" />
				<Boton href="#contact" texto="Contactar" bottonI18n="hero.buttonContact" variant="ghost" />
			</div>
		</div>
		<Image
			class="hero__img"
			src={foto}
			alt="Franklin Amador - Full Stack & Data Engineer"
			width={380}
			densities={[1, 2]}
			format="webp"
			loading="eager"
			fetchpriority="high"
		/>
	</div>
</section>
