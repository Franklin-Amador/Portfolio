---
import Title from '../atoms/Title.astro';
import SocialIcons from '../SocialIcons.astro';
import './contact.css';
---

<section id="contact" class="contact">
	<div class="contact__container">
		<Title margin="2rem" contenido="Contacto" i18nKey="contact.title" />
		<p class="contact__description" data-i18n="contact.description">
			¿Tienes un proyecto en mente? ¿Quieres colaborar? ¡Hablemos! Estoy disponible para nuevas oportunidades y proyectos interesantes.
		</p>
		
		<div class="contact__content">
			<div class="contact__info">
				<a href="mailto:joelamador55@gmail.com" class="contact__item" data-reveal>
					<iconify-icon icon="mdi:email" width="30" height="30"></iconify-icon>
					<div>
						<h3 data-i18n="contact.emailLabel">Email</h3>
						<span class="contact__link" data-i18n="contact.emailText">Envíame un correo</span>
					</div>
				</a>

				<a href="https://github.com/Franklin-Amador" target="_blank" rel="noopener noreferrer" class="contact__item" data-reveal style="--reveal-delay: 80ms">
					<iconify-icon icon="mdi:github" width="30" height="30"></iconify-icon>
					<div>
						<h3 data-i18n="contact.githubLabel">GitHub</h3>
						<span class="contact__link">Franklin-Amador</span>
					</div>
				</a>

				<a href="https://www.linkedin.com/in/franklin-amador-438321367" target="_blank" rel="noopener noreferrer" class="contact__item" data-reveal style="--reveal-delay: 160ms">
					<iconify-icon icon="mdi:linkedin" width="30" height="30"></iconify-icon>
					<div>
						<h3 data-i18n="contact.linkedinLabel">LinkedIn</h3>
						<span class="contact__link" data-i18n="contact.linkedinText">Conéctate conmigo</span>
					</div>
				</a>
			</div>

			<div class="contact__social" data-reveal="right">
				<h3 data-i18n="contact.followLabel">Sígueme en redes sociales</h3>
				<SocialIcons width="35" height="35"/>
				<p class="contact__availability" data-i18n="contact.availability">
					💼 Disponible para trabajos freelance y oportunidades laborales
				</p>
			</div>
		</div>
	</div>
</section>
