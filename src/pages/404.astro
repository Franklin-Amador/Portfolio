---
import Boton from "../components/atoms/Boton.astro";
import Layout from "../layouts/Layout.astro";


---

<Layout title="Pagina no encontrada">
	<main class="not-found">
		<p class="not-found__code color__gradiente">404</p>
		<h1 class="not-found__title">Página no encontrada</h1>
		<p class="not-found__text">La página que buscas no existe o fue movida.</p>
		<Boton texto="Volver al inicio" href="/" variant="primary" />
	</main>
</Layout>

<style>
	.not-found {
		min-height: 70vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		gap: 1.6rem;
		text-align: center;
		padding: var(--section-py) var(--section-px);
	}

	.not-found__code {
		font-size: clamp(8rem, 6rem + 10vw, 16rem);
		font-weight: 700;
		line-height: 1;
		margin: 0;
	}

	.not-found__title {
		font-size: var(--text-xx-large);
		font-weight: 600;
		color: var(--primary-100);
		margin: 0;
	}

	.not-found__text {
		font-size: var(--text-large);
		color: var(--primary-80);
		margin: 0 0 1.6rem;
	}
</style>
